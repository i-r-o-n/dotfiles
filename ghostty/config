font-size = 36

window-padding-x = 0
window-padding-y = 0

gtk-titlebar = true
gtk-tabs-location = hidden

# theme = "Adwaita Dark"
theme = custom-dark

background = 000000

keybind = ctrl+shift+space=toggle_tab_overview

keybind = ctrl+shift+o=new_tab
keybind = ctrl+shift+a=next_tab
keybind = ctrl+shift+c=previous_tab

keybind = ctrl+shift+x=close_tab

keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+f=toggle_split_zoom

keybind = ctrl+shift+d=new_split:down 
keybind = ctrl+shift+e=new_split:auto

keybind = ctrl+shift+w=close_window
keybind = ctrl+shift+enter=new_window

# keybind = space>u+z=reset_font_size
keybind = ctrl+shift+plus=increase_font_size:20
keybind = ctrl+shift+minus=decrease_font_size:20
