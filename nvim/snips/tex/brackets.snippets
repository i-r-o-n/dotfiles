global !p
from latex_environments import math, comment, env
endglobal

context "math()"
# snippet () "left( right)" iA
# \left( ${1:${VISUAL}} \right) $0
# endsnippet
snippet pr "()" A
(${1:${VISUAL}}) $0
endsnippet

context "math()"
snippet lrp "left( right)" iA
\left( ${1:${VISUAL}} \right) $0
endsnippet
context "math()"
snippet lr( "left( right)" i
\left( ${1:${VISUAL}} \right) $0
endsnippet

snippet lr| "left| right|" i
\left| ${1:${VISUAL}} \right| $0
endsnippet

snippet lr{ "left\{ right\}" i
\left\\{ ${1:${VISUAL}} \right\\} $0
endsnippet
snippet lrb "left\{ right\}" i
\left\\{ ${1:${VISUAL}} \right\\} $0
endsnippet

snippet lr[ "left[ right]" i
\left[ ${1:${VISUAL}} \right] $0
endsnippet


snippet lra "leftangle rightangle" iA
\left<${1:${VISUAL}} \right>$0
endsnippet
