global !p
from latex_environments import math, comment, env
endglobal

context "math()"
snippet sum "sum" wA
\sum_{${1:n=1}}^{${2:\infty}} $3
endsnippet
# \sum_{n=${1:1}}^{${2:\infty}} ${3:a_n z^n}

snippet taylor "taylor" w
\sum_{${1:k}=${2:0}}^{${3:\infty}} ${4:c_$1} (x-a)^$1 $0
endsnippet

context "math()"
snippet lim "limit" wA
\lim_{${1:n} \to ${2:\infty}} 
endsnippet

context "math()"
snippet lsup "limsup" wA
\limsup_{${1:n} \to ${2:\infty}} 
endsnippet

snippet prod "product" w
\prod_{${1:n=${2:1}}}^{${3:\infty}} ${4:${VISUAL}} $0
endsnippet

priority 300
context "math()"
snippet dint "definite integral" wA
\int_{${1:-\infty}}^{${2:\infty}} ${3:${VISUAL}} \,d$0
endsnippet

priority 100
context "math()"
snippet '(?<!\\)(sin|cos|arccot|cot|csc|ln|log|exp|star|perp|det|sup|mod)' "functions with bracketed arguments" rwA
\\`!p snip.rv = match.group(1)`{$1} $0
endsnippet

priority 200
context "math()"
snippet '(?<!\\)(arcsin|arccos|arctan|arccot|arccsc|arcsec|pi|zeta|int|mid)' "functions" rwA
\\`!p snip.rv = match.group(1)`$1 $0
endsnippet

snippet '([a-zA-Z])abs' "|_| bars" rwA
|`!p snip.rv = match.group(1)`| 
endsnippet

context "math()"
snippet ceil "ceil" iA
\left\lceil $1 \right\rceil $0
endsnippet

context "math()"
snippet floor "floor" iA
\left\lfloor $1 \right\rfloor$0
endsnippet

snippet bigfun "big function" iA
\begin{align*}
	$1: $2 &\longrightarrow $3 \\\\
	$4 &\longmapsto $1($4) = $0
.\end{align*}
endsnippet

priority 200
context "math()"
snippet <-> "leftrightarrow" iA
\leftrightarrow
endsnippet

context "math()"
snippet !> "mapsto" iA
\mapsto 
endsnippet

context "math()"
snippet mto "mapsto" iA
\mapsto 
endsnippet

priority 100
context "math()"
snippet lmto "longmapsto" iA
\longmapsto
endsnippet

context "math()"
snippet --> "longrightarrow" iA 
\longrightarrow
endsnippet

snippet >> ">>" iA
\gg 
endsnippet

snippet << "<<" iA
\ll
endsnippet

snippet ~~ "~" iA
\sim 
endsnippet

priority 100
context "math()"
snippet -> "to" iA
\to 
endsnippet

context "math()"
snippet ucnv "uniform convergence" iA 
\rightrightarrows
endsnippet

context "math()"
snippet to "to" iA
\to 
endsnippet

context "math()"
snippet appx "approximately equal to" iA 
\approx 
endsnippet

snippet <! "normal" iA
\triangleleft 
endsnippet

snippet <> "booth" iA
\diamond 
endsnippet
